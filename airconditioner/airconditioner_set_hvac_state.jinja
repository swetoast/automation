{% set sensor_list = [
  {'key': 'hum',          'entity': 'sensor.average_humidity_tracker'},
  {'key': 'comfort_temp', 'entity': 'sensor.comfort_zone_temperature'},
  {'key': 'price_thr',    'entity': 'input_number.price_guard_threshold'},
  {'key': 'mold_risk',     'entity': 'sensor.wave_mini_mold'}
] %}

{% set flag_list = [
  {'key': 'window_open',       'entity': 'binary_sensor.living_room_window_sensor'},
  {'key': 'window_bed_door',   'entity': 'binary_sensor.window_sensor_bedroom_door'},
  {'key': 'lightning',         'entity': 'binary_sensor.lightning_monitor'},
  {'key': 'outlet_overloaded', 'entity': 'binary_sensor.ac_outlet_overloaded'},
  {'key': 'price_guard',       'entity': 'binary_sensor.price_guard'},
  {'key': 'motion_living',     'entity': 'binary_sensor.motion_living_room'},
  {'key': 'smoke', 'entity': 'binary_sensor.smoke_alarm_smoke'},
  {'key': 'shower',            'entity': 'binary_sensor.shower'}
] %}

{% set override_list = [
  {'key': 'ov_all',      'entity': 'input_boolean.airconditioner_override_all'},
  {'key': 'ov_not_home', 'entity': 'input_boolean.toggle_override_not_at_home'},
  {'key': 'ov_price',    'entity': 'input_boolean.override_price_guard'},
  {'key': 'ov_light',    'entity': 'input_boolean.air_conditioner_override_lightning_safeguard'},
  {'key': 'ov_comf',     'entity': 'input_boolean.air_conditioner_override_comformt'}
] %}

{% set all_entities = [] %}
{% for item in sensor_list   %}{% set all_entities = all_entities + [item.entity] %}{% endfor %}
{% for item in flag_list     %}{% set all_entities = all_entities + [item.entity] %}{% endfor %}
{% for item in override_list %}{% set all_entities = all_entities + [item.entity] %}{% endfor %}
{% set all_entities = all_entities + [
  'sensor.vattenfall_pricing',
  'sensor.combined_hourly_weather',
  'climate.air_conditioner',
  'person.toast',
  'sensor.thermal_comfort_thoms_discomfort_perception_2',
  'sensor.thermal_comfort_humidex_perception_2'
] %}

{% set invalid = [] %}
{% for ent in all_entities %}
  {% if states(ent) in ['unavailable','unknown'] %}
    {% set invalid = invalid + [ent ~ ' (' ~ states(ent) ~ ')'] %}
  {% endif %}
{% endfor %}

{% set hum_low_thr  = 0.30 %}
{% set hum_high_thr = 0.60 %}
{% set ns = namespace(values={}) %}

{% for item in sensor_list %}
  {% set ns.values = ns.values | combine({ (item.key): states(item.entity) | float(0) }) %}
{% endfor %}

{% for item in flag_list %}
  {% set ns.values = ns.values | combine({ (item.key): is_state(item.entity, 'on') }) %}
{% endfor %}

{% for item in override_list %}
  {% set ns.values = ns.values | combine({ (item.key): is_state(item.entity, 'on') }) %}
{% endfor %}

{% set cp = state_attr('binary_sensor.price_guard','current_price') | float(0) %}
{% set ns.values = ns.values | combine({ 'current_price': cp }) %}
{% set ns.values = ns.values | combine({
  'severity':   state_attr('sensor.vattenfall_pricing', 'severity_scale'),
  'home_state': is_state('person.toast', 'home'),
  'forecast':   state_attr('sensor.combined_hourly_weather', 'forecast'),
  'prev_mode':  states('climate.air_conditioner'),
  'thoms_state': states('sensor.thermal_comfort_thoms_discomfort_perception_2')
}) %}

{% set humidex = states('sensor.thermal_comfort_humidex_perception_2') %}
{% set overwrite_mode = none %}
{% if humidex in ['noticable_discomfort','evident_discomfort','great_discomfort'] %}
  {% set overwrite_mode = 'dry' %}
{% elif humidex in ['dangerous_discomfort','heat_stroke'] %}
  {% set overwrite_mode = 'cool' %}
{% endif %}

{% set thoms = ns.values.thoms_state %}
{% set thoms_mode = none %}
{% if thoms == 'no_discomfort' %}
  {% set thoms_mode = 'off' %}
{% elif thoms in ['less_than_half','more_than_half','most','everyone','dangerous'] %}
  {% set thoms_mode = 'cool' %}
{% endif %}

{% set ac_modes = ['off','dry','cool','fan_only'] %}

{% set rules = [
  { 'name': 'Window closed & hot & AC cooling → fan_only',
    'passed': (not ns.values.window_open
               and ns.values.thoms_state != 'no_discomfort'
               and ns.values.prev_mode == 'cool'),
    'mode': 'fan_only' },
  {
    'name':  'Smoke detected → off',
    'passed': is_state('binary_sensor.smoke_alarm_smoke','on'),
    'mode':  'off'
  },
  { 'name': 'Global override → off',
    'passed': ns.values.ov_all,
    'mode': 'off' },

  { 'name': 'Not home & no override → off',
    'passed': (not ns.values.home_state and not ns.values.ov_not_home),
    'mode': 'off' },

  { 'name': 'Lightning safeguard → off',
    'passed': (ns.values.lightning and not ns.values.ov_light),
    'mode': 'off' },

  { 'name': 'Outlet overloaded → off',
    'passed': (ns.values.outlet_overloaded and not ns.values.ov_comf),
    'mode': 'off' },
    
  { 'name': 'Shower running → dry',
    'passed': ns.values.shower,
    'mode': 'dry' },
  
  {
    'name': 'Bedroom window open → fan_only',
    'passed': ns.values.window_bed_door,
    'mode': 'fan_only'
  },
  {
    'name':  'High mold risk → dry',
    'passed': (ns.values.mold_risk | float(0)) >= 5,
    'mode':  'dry'
  }
] %}

{% set rules = rules + [
  { 'name': 'Price extreme → off',
    'passed': (ns.values.price_guard
               and ns.values.current_price > ns.values.price_thr
               and ns.values.severity == 'extreme'
               and not ns.values.ov_price),
    'mode': 'off' },

  { 'name': 'Price high & hot → fan_only',
    'passed': (ns.values.price_guard
               and ns.values.current_price > ns.values.price_thr
               and ns.values.severity == 'high'
               and not ns.values.ov_price
               and ns.values.thoms_state != 'no_discomfort'),
    'mode': 'fan_only' }
] %}

{% if overwrite_mode %}
  {% set rules = rules + [{
    'name': 'Humidex override → ' ~ overwrite_mode,
    'passed': true,
    'mode': overwrite_mode
  }] %}
{% endif %}

{% set rules = rules + [
  { 'name': 'Too dry → off',
    'passed': (ns.values.hum < hum_low_thr
               and thoms in ['more_than_half','most','everyone','dangerous']),
    'mode': 'off' }
] %}

{% if thoms_mode %}
  {% set rules = rules + [{
    'name': 'THOMS comfort → ' ~ thoms_mode,
    'passed': true,
    'mode': thoms_mode
  }] %}
{% endif %}

{% set passed = rules | selectattr('passed') | list %}
{% if passed %}
  {% set fired = passed[0] %}
{% else %}
  {% set fired = {
    'name': 'Maintain previous mode',
    'mode': ns.values.prev_mode
  } %}
{% endif %}

{% set mode = fired.mode %}
{% if mode not in ac_modes %}
  {% set mode = ns.values.prev_mode %}
{% endif %}

{{ mode }}
