{% set hot_threshold     = 25.0 %}
{% set S                 = 5.0 %}
{% set M                 = 3.0 %}
{% set daytime_min_drop  = 1.0 %}
{% set daytime_max_drop  = 2.0 %}
{% set night_min_drop    = 2.0 %}
{% set night_max_drop    = 4.0 %}
{% set pre_cool_max_drop = 2.0 %}
{% set forecast_horizon  = 3 %}
{% set comfort_thr       = 25.0 %}
{% set comfort_factor    = 0.1 %}
{% set hum_thr           = 5.0 %}
{% set hum_drop          = 0.5 %}

{% set indoor       = states('sensor.comfort_zone_temperature')     | float %}
{% set outside      = state_attr('weather.home','temperature')      | float %}
{% set sun_state    = states('sun.sun')                             %}
{% set is_day       = sun_state == 'above_horizon'                  %}
{% set HI           = states('sensor.thermal_comfort_heat_index_2') | float %}
{% set Hx           = states('sensor.thermal_comfort_humidex_2')     | float %}
{% set dtemp_rate   = states('sensor.average_temperature_tracker')  | float %}
{% set dhum_rate    = states('sensor.average_humidity_tracker')     | float %}
{% set forecast     = state_attr('sensor.combined_hourly_weather','forecast') or [] %}

{% set cidx         = [HI, Hx] | max %}
{% set cexcess      = cidx > comfort_thr and (cidx - comfort_thr) or 0 %}
{% set drop_night   = sun_state == 'below_horizon' and (cexcess * comfort_factor) or 0 %}

{% set diff         = indoor - outside %}
{% set drop_base    = (diff * S) / (diff + S) %}
{% set hot_diff     = outside > hot_threshold and (outside - hot_threshold) or 0 %}
{% set drop_extra   = hot_diff > 0 and (hot_diff * M / (hot_diff + M)) or 0 %}

{% set peak         = 0.0 %}
{% for e in forecast[:forecast_horizon] %}
  {% if e.temperature is defined and e.temperature > peak %}
    {% set peak = e.temperature %}
  {% endif %}
{% endfor %}
{% set fdiff        = peak > hot_threshold and (peak - hot_threshold) or 0 %}
{% set drop_pre     = fdiff > 0 
                       and (fdiff * pre_cool_max_drop / (fdiff + pre_cool_max_drop))
                       or 0 %}

{% set drop_hum     = dhum_rate > hum_thr and hum_drop or 0 %}

{% set total_drop   = drop_base + drop_extra + drop_pre + drop_night + drop_hum %}

{% if is_day %}
  {% set applied_drop = [daytime_min_drop, [total_drop, daytime_max_drop] | min] | max %}
{% else %}
  {% set applied_drop = [night_min_drop, [total_drop, night_max_drop]   | min] | max %}
{% endif %}

{% set raw_target   = (indoor | round(0,'floor')) - applied_drop %}
{% set clamped      = [16, [raw_target, 32] | min] | max %}

{% if dtemp_rate > 0.2 %}
  {% set target = clamped | round(0,'floor') | int %}
{% elif dtemp_rate < -0.2 %}
  {% set target = clamped | round(0,'ceil')  | int %}
{% else %}
  {% set target = clamped | round(0)          | int %}
{% endif %}

Parameters:
  hot_threshold:     {{ hot_threshold }}
  S-factor:          {{ S }}
  M-factor:          {{ M }}
  daytime_min_drop:  {{ daytime_min_drop }}
  daytime_max_drop:  {{ daytime_max_drop }}
  night_min_drop:    {{ night_min_drop }}
  night_max_drop:    {{ night_max_drop }}
  pre_cool_max_drop: {{ pre_cool_max_drop }}
  forecast_horizon:  {{ forecast_horizon }}
  comfort_thr:       {{ comfort_thr }}
  comfort_factor:    {{ comfort_factor }}
  hum_thr:           {{ hum_thr }}
  hum_drop:          {{ hum_drop }}

Inputs:
  indoor:            {{ indoor }} °C
  outside:           {{ outside }} °C
  sun_state:         {{ sun_state }}
  is_day:            {{ is_day }}
  HI:                {{ HI }} °C
  Hx:                {{ Hx }} °C
  Δtemp_rate:        {{ dtemp_rate }} °C/min
  Δhum_rate:         {{ dhum_rate }} %/min
  forecast:          {{ forecast[:forecast_horizon] }}

Comfort Drop:
  cidx:              {{ cidx }}
  cexcess:           {{ cexcess }}
  drop_night:        {{ drop_night }}

Drop Components:
  diff:              {{ diff }}
  drop_base:         {{ drop_base }}
  hot_diff:          {{ hot_diff }}
  drop_extra:        {{ drop_extra }}
  peak (forecast):   {{ peak }}
  fdiff:             {{ fdiff }}
  drop_pre:          {{ drop_pre }}
  drop_hum:          {{ drop_hum }}
  total_drop:        {{ total_drop }}

Clamping:
  applied_drop:      {{ applied_drop }}
  raw_target:        {{ raw_target }}
  clamped:           {{ clamped }}

Final Target:
  target:            {{ target }} °C
