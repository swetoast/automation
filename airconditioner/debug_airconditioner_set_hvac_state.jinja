{% set hum_low_thr  = 0.30 %}
{% set hum_high_thr = 0.60 %}

{% set sensor_list = [
  {'key': 'hum',           'entity': 'sensor.average_humidity_tracker'},
  {'key': 'comfort_temp',  'entity': 'sensor.comfort_zone_temperature'},
  {'key': 'current_price', 'entity': 'sensor.current_price_incl_vat'},
  {'key': 'price_thr',     'entity': 'input_number.price_guard_threshold'}
] %}

{% set flag_list = [
  {'key': 'window_open',       'entity': 'binary_sensor.living_room_window_sensor'},
  {'key': 'window_bed_door',   'entity': 'binary_sensor.window_sensor_bedroom_door'},
  {'key': 'lightning',         'entity': 'binary_sensor.lightning_monitor'},
  {'key': 'outlet_overloaded', 'entity': 'binary_sensor.ac_outlet_overloaded'},
  {'key': 'price_throttle',    'entity': 'binary_sensor.price_throttle'},
  {'key': 'motion_living',     'entity': 'binary_sensor.motion_living_room'}
] %}

{% set override_list = [
  {'key': 'ov_all',      'entity': 'input_boolean.airconditioner_override_all'},
  {'key': 'ov_not_home', 'entity': 'input_boolean.toggle_override_not_at_home'},
  {'key': 'ov_price',    'entity': 'input_boolean.override_price_guard'},
  {'key': 'ov_light',    'entity': 'input_boolean.air_conditioner_override_lightning_safeguard'},
  {'key': 'ov_comf',     'entity': 'input_boolean.air_conditioner_override_comformt'}
] %}

{% set ns = namespace(values={}) %}

{#— Load numeric sensors —#}
{% for item in sensor_list %}
  {% set ns.values = ns.values
     | combine({ (item['key']): states(item['entity']) | float }) %}
{% endfor %}

{#— Load binary flags —#}
{% for item in flag_list %}
  {% set ns.values = ns.values
     | combine({ (item['key']): is_state(item['entity'],'on') }) %}
{% endfor %}

{#— Load override toggles —#}
{% for item in override_list %}
  {% set ns.values = ns.values
     | combine({ (item['key']): is_state(item['entity'],'on') }) %}
{% endfor %}

{#— Extras: severity, home state, forecast, prev_mode, THOMS raw state —#}
{% set ns.values = ns.values | combine({
  'severity':    state_attr('binary_sensor.price_throttle','severity_scale'),
  'home_state':  is_state('person.toast','home'),
  'forecast':    state_attr('sensor.combined_hourly_weather','forecast'),
  'prev_mode':   states('climate.air_conditioner'),
  'thoms_state': states('sensor.thermal_comfort_thoms_discomfort_perception')
}) %}

{#— Optional Humidex override —#}
{% set humidex_state = states('sensor.thermal_comfort_humidex_perception_2') %}
{% set overwrite_mode = none %}
{% if humidex_state in [
     'noticable_discomfort',
     'evident_discomfort',
     'great_discomfort'
   ] %}
  {% set overwrite_mode = 'dry' %}
{% elif humidex_state in [
     'dangerous_discomfort',
     'heat_stroke'
   ] %}
  {% set overwrite_mode = 'cool' %}
{% endif %}

{#— Dynamic THOMS mapping —#}
{% set thoms_options = [
  'no_discomfort',
  'less_than_half',
  'more_than_half',
  'most',
  'everyone',
  'dangerous'
] %}
{% set thoms_state = ns.values.thoms_state %}
{% set thoms_idx   = thoms_state in thoms_options
    and thoms_options.index(thoms_state)
    or 0 %}
{% set base_mode = thoms_idx == 0 and 'off'
                 or thoms_idx == 1 and 'fan_only'
                 or 'cool' %}

{% set ac_modes = ['off','dry','cool','fan_only'] %}

{#— Rule definitions in priority order —#}
{% set rules = [
  { 'name': 'Global override → off',
    'passed': ns.values.ov_all,
    'mode':   'off' },

  { 'name': 'Not home & no override → off',
    'passed': (not ns.values.home_state and not ns.values.ov_not_home),
    'mode':   'off' },

  { 'name': 'Lightning safeguard → off',
    'passed': (ns.values.lightning and not ns.values.ov_light),
    'mode':   'off' },

  { 'name': 'Outlet overloaded → off',
    'passed': (ns.values.outlet_overloaded and not ns.values.ov_comf),
    'mode':   'off' },

  { 'name': 'Window open & occupied → fan_only',
    'passed': (
      (ns.values.window_open and ns.values.motion_living) or
      (ns.values.window_bed_door and ns.values.home_state)
    ),
    'mode':   'fan_only' }
] %}

{#— Inject Humidex override at top if active —#}
{% if overwrite_mode %}
  {% set rules = rules + [{
    'name':   'Humidex override → ' ~ overwrite_mode,
    'passed': true,
    'mode':   overwrite_mode
  }] %}
{% endif %}

{#— Price throttle rules —#}
{% set rules = rules + [
  { 'name': 'Price extreme → off',
    'passed': (
      ns.values.price_throttle and
      ns.values.current_price > ns.values.price_thr and
      ns.values.severity == 'extreme' and
      not ns.values.ov_price
    ),
    'mode':   'off' },

  { 'name': 'Price high → fan_only',
    'passed': (
      ns.values.price_throttle and
      ns.values.current_price > ns.values.price_thr and
      ns.values.severity == 'high' and
      not ns.values.ov_price
    ),
    'mode':   'fan_only' }
] %}

{#— Dryness override —#}
{% set rules = rules + [
  { 'name': 'Too dry → off',
    'passed': ns.values.hum < hum_low_thr and thoms_idx > 0,
    'mode':   'off' }
] %}

{#— Final THOMS-based fallback —#}
{% set rules = rules + [
  { 'name': 'THOMS mapping → ' ~ base_mode,
    'passed': true,
    'mode':   base_mode }
] %}

{#— Select first passed rule or fallback to prev_mode —#}
{% set passed = rules | selectattr('passed') | list %}
{% if passed | length > 0 %}
  {% set fired = passed[0] %}
{% else %}
  {% set fired = { 'name': 'Maintain previous mode', 'mode': ns.values.prev_mode } %}
{% endif %}

{% set mode = fired.mode %}
{% if mode not in ac_modes %}
  {% set mode = ns.values.prev_mode %}
{% endif %}

Final AC Mode: {{ mode }}
Reason: {{ fired.name }}

Rules evaluation:
{% for rule in rules %}
- {{ '[✔]' if rule.passed else '[✘]' }} {{ rule.name }}
{% endfor %}
