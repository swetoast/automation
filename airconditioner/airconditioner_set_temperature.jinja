{% set hot_threshold     = 25.0 %}
{% set S                 = 5.0 %}
{% set M                 = 3.0 %}
{% set daytime_min_drop  = 1.0 %}
{% set daytime_max_drop  = 2.0 %}
{% set night_min_drop    = 2.0 %}
{% set night_max_drop    = 4.0 %}
{% set pre_cool_max_drop = 2.0 %}
{% set forecast_horizon  = 3 %}
{% set comfort_thr       = 25.0 %}
{% set comfort_factor    = 0.1 %}
{% set hum_thr           = 5.0 %}
{% set hum_drop          = 0.5 %}
{% set outside_bonus_max = 2.0 %}
{% set hysteresis_thresh = 0.2 %}

{% set indoor        = states('sensor.comfort_zone_temperature')          | float(0) %}
{% set outside       = state_attr('weather.home','temperature')           | float(0) %}
{% set is_day        = states('sun.sun') == 'above_horizon'               %}
{% set HI            = states('sensor.thermal_comfort_heat_index_2')      | float(0) %}
{% set Hx            = states('sensor.thermal_comfort_humidex_2')          | float(0) %}
{% set dout_rate     = states('sensor.outside_weather_tracker')           | float(0) %}
{% set dhum_out_rate = states('sensor.outside_humidity_tracker')          | float(0) %}
{% set dhum_in_rate  = states('sensor.average_humidity_tracker')          | float(0) %}
{% set forecast      = state_attr('sensor.combined_hourly_weather','forecast') or [] %}

{% set comfort_idx     = [HI, Hx] | max %}
{% set comfort_excess  = comfort_idx > comfort_thr and (comfort_idx - comfort_thr) or 0 %}
{% set drop_comfort    = comfort_excess * comfort_factor %}

{% set diff        = indoor - outside %}
{% set drop_base   = diff > 0 and (diff * S) / (diff + S) or 0 %}
{% set hot_diff    = outside > hot_threshold and (outside - hot_threshold) or 0 %}
{% set drop_extra  = hot_diff > 0 and (hot_diff * M / (hot_diff + M)) or 0 %}

{% set peak = namespace(val=0.0) %}
{% for e in forecast[:forecast_horizon] %}
  {% if e.temperature is defined and e.temperature > peak.val %}
    {% set peak.val = e.temperature %}
  {% endif %}
{% endfor %}
{% set fc_diff   = peak.val > hot_threshold and (peak.val - hot_threshold) or 0 %}
{% set drop_pre  = fc_diff > 0
                   and (fc_diff * pre_cool_max_drop
                        / (fc_diff + pre_cool_max_drop))
                   or 0 %}

{% set drop_hum_out = dhum_out_rate > hum_thr and hum_drop or 0 %}
{% set drop_hum_in  = dhum_in_rate  > hum_thr and hum_drop or 0 %}

{% set drop_outside = diff > 0
                     and (diff * outside_bonus_max
                          / (diff + outside_bonus_max))
                     or 0 %}
{% set drop_trend   = dout_rate > 0
                     and (dout_rate * outside_bonus_max)
                     or 0 %}

{% set total_drop = drop_base
                 + drop_extra
                 + drop_pre
                 + drop_comfort
                 + drop_hum_out
                 + drop_hum_in
                 + drop_outside
                 + drop_trend %}

{% if is_day %}
  {% set applied_drop = [daytime_min_drop,
                         [total_drop, daytime_max_drop] | min]
                        | max %}
{% else %}
  {% set applied_drop = [night_min_drop,
                         [total_drop, night_max_drop]   | min]
                        | max %}
{% endif %}

{% set raw_target = (indoor | round(0, 'floor')) - applied_drop %}
{% set clamped    = [16, [raw_target, 32] | min] | max %}

{% if dout_rate > hysteresis_thresh %}
  {% set target = clamped | round(0, 'floor') | int %}
{% elif dout_rate < -hysteresis_thresh %}
  {% set target = clamped | round(0, 'ceil')  | int %}
{% else %}
  {% set target = clamped | round(0)          | int %}
{% endif %}

{{ target }}
