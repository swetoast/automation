{% set activity = states('sensor.pixel_8_pro_detected_activity') %}
{% set phone_state = states('sensor.pixel_8_pro_phone_state') %}
{% set location = states('person.toast') %}
{% set interactive = states('binary_sensor.pixel_8_pro_interactive') %}
{% set bedtime_mode = states('binary_sensor.google_pixel_watch_2_bedtime_mode') %}
{% set tv_status = states('media_player.bedroom_tv') %}
{% set music_status = states('media_player.plexamp_android_phone') %}
{% set work_laptop_status = states('device_tracker.work_laptop') %}

{% set messages = [] %}

{% if activity == 'running' %}
  {% set messages = messages + ["You're out for a run."] %}
{% elif activity == 'on_bicycle' %}
  {% set messages = messages + ["Cycling around."] %}
{% elif activity == 'still' %}
  {% set messages = messages + ["Taking a break, staying still."] %}
{% elif activity == 'in_vehicle' %}
  {% set messages = messages + ["Traveling in a vehicle."] %}
{% elif activity == 'on_foot' %}
  {% set messages = messages + ["Moving on foot."] %}
{% elif activity == 'walking' %}
  {% set messages = messages + ["Out for a walk."] %}
{% elif activity == 'tilting' %}
  {% set messages = messages + ["Your device is tilting."] %}
{% endif %}

{% if phone_state == 'offhook' %}
  {% set messages = messages + ["On a call."] %}
{% elif phone_state == 'ringing' %}
  {% set messages = messages + ["Phone is ringing."] %}
{% endif %}

{% if location == 'home' %}
  {% set messages = messages + ["Relaxing at home."] %}
{% elif location == 'work' %}
  {% set messages = messages + ["Busy at work."] %}
{% endif %}

{% if interactive == 'on' %}
  {% set messages = messages + ["Using your device."] %}
{% endif %}

{% if bedtime_mode == 'on' %}
  {% set messages = messages + ["In bed. Sweet dreams!"] %}
{% endif %}

{% if tv_status == 'playing' %}
  {% set messages = messages + ["Watching TV."] %}
{% endif %}

{% if music_status == 'playing' %}
  {% set messages = messages + ["Listening to music."] %}
{% endif %}

{% if work_laptop_status == 'home' %}
  {% set messages = messages + ["Working from home."] %}
{% endif %}

{% if messages | length > 0 %}
  {{ messages | join(' ') }}
{% else %}
  No relevant data available.
{% endif %}
