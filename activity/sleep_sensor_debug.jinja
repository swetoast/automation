{% if not is_state('person.toast', 'home') %}
  { "sleep_probability": 0, "note": "User not home" }
{% else %}
  {% set bedroom_occupied = is_state('binary_sensor.aqara_presence_multisensor_fp300_occupancy', 'on') %}
  {% set livingroom_occupied = is_state('binary_sensor.presence_sensor', 'on') %}
  {% set kitchen_occupied = is_state('binary_sensor.kitchen_presence_sensor', 'on') %}
  {% set bathroom_occupied = is_state('binary_sensor.aqura_bathroom_occupancy_sensor', 'on') %}
  {% set entryway_occupied = is_state('binary_sensor.entryway_detection', 'on') %}
  {% set elsewhere_occupied = livingroom_occupied or kitchen_occupied or bathroom_occupied or entryway_occupied %}
  {% set gaming_on = is_state('binary_sensor.gaming_sensor', 'on') %}
  {% set shower_on = is_state('binary_sensor.shower', 'on') %}
  {% set tv_on = is_state('media_player.bedroom_tv', 'playing') or is_state('media_player.bedroom_tv', 'paused') %}
  {% set quest_on = is_state('binary_sensor.quest_2_in_use', 'on') %}
  {% set hideaway_on = is_state('binary_sensor.hideaway', 'on') %}
  {% set work_pc_on = is_state('binary_sensor.work_computer', 'on') %}
  {% set phone_active = is_state('binary_sensor.pixel_8_pro_interactive', 'on') %}
  {% set bedtime_mode_on = is_state('binary_sensor.google_pixel_watch_2_bedtime_mode', 'on') %}
  {% set phone_doze_on = is_state('binary_sensor.pixel_8_pro_doze_mode', 'on') %}
  {% set comfort_ok = is_state('binary_sensor.comfort_levels', 'on') %}

  {% set now_ts = now() | as_timestamp %}
  {% set gaming_last_ts = states.binary_sensor.gaming_sensor.last_changed | as_timestamp %}
  {% set shower_last_ts = states.binary_sensor.shower.last_changed | as_timestamp %}
  {% set tv_last_ts = states.media_player.bedroom_tv.last_changed | as_timestamp %}
  {% set quest_last_ts = states.binary_sensor.quest_2_in_use.last_changed | as_timestamp %}
  {% set hideaway_last_ts = states.binary_sensor.hideaway.last_changed | as_timestamp %}
  {% set work_pc_last_ts = states.binary_sensor.work_computer.last_changed | as_timestamp %}
  {% set phone_last_ts = states.binary_sensor.pixel_8_pro_interactive.last_changed | as_timestamp %}

  {% set GAMING_COOLDOWN = 30 %}
  {% set SHOWER_COOLDOWN = 20 %}
  {% set TV_COOLDOWN = 20 %}
  {% set QUEST_COOLDOWN = 30 %}
  {% set HIDEAWAY_COOLDOWN = 30 %}
  {% set WORK_PC_COOLDOWN = 30 %}
  {% set PHONE_COOLDOWN = 15 %}

  {% set bedroom_lux = states('sensor.bedroom_illuminace') | float(0) %}
  {% set livingroom_lux = states('sensor.livingroom_lux_sensor') | float(0) %}
  {% set bedroom_noise = states('sensor.bedroom_sound_pressure') | float(0) %}
  {% set noise_baseline = states('sensor.bedroom_noise_baseline') | float(0) %}
  {% set bedroom_temp = states('sensor.bedroom_temperature') | float(0) %}
  {% set temp_baseline = states('sensor.bedroom_temperature_baseline') | float(0) %}
  {% set humidity = states('sensor.bedroom_humidity') | float(0) %}
  {% set co2_tracker = states('sensor.bedroom_co2_tracker') | float(0) %}
  {% set voc_tracker = states('sensor.bedroom_voc_tracker') | float(0) %}
  {% set motion_level = state_attr('sensor.pixel_8_pro_sleep_confidence', 'motion') | int(10) %}
  {% set hr_current = states('sensor.my_current_heart_rate') | float(0) %}
  {% set hr_resting = states('sensor.peter_s_resting_heart_rate') | float(0) %}

  {% set lux_diff = livingroom_lux - bedroom_lux %}
  {% set darkness_factor = max(0, min(1, (15 - bedroom_lux) / 15)) %}
  {% set light_diff_ok = max(0, min(1, (5 - lux_diff) / 5)) %}
  {% set noise_delta = bedroom_noise - noise_baseline %}
  {% set quietness_factor = max(0, min(1, (3 - noise_delta) / 3)) %}
  {% set temp_diff_abs = (bedroom_temp - temp_baseline) | abs %}
  {% set temperature_stability = max(0, min(1, (1 - temp_diff_abs) / 1)) %}
  {% set humidity_offset = (humidity - 50) | abs %}
  {% set humidity_ok = 1 if (humidity >= 40 and humidity <= 60) else max(0, min(1, 1 - (humidity_offset / 20))) %}
  {% set co2_rising_flag = 1 if co2_tracker > 0.5 else 0 %}
  {% set voc_rising_flag = 1 if voc_tracker > 0.5 else 0 %}
  {% set phone_still_factor = max(0, min(1, (3 - motion_level) / 3)) %}
  {% set hr_delta = hr_current - hr_resting %}
  {% set hr_sleep_factor = 1 / (1 + (2.71828 ** (0.25 * (hr_delta - 10)))) %}

  {% set se_bedtime = 0.7 if bedtime_mode_on else 0 %}
  {% set se_phone_doze = 0.4 if phone_doze_on else 0 %}
  {% set se_comfort = 0.4 if comfort_ok else 0 %}
  {% set se_darkness = darkness_factor * 1.0 %}
  {% set se_light_diff = light_diff_ok * 0.3 %}
  {% set se_quietness = quietness_factor * 0.5 %}
  {% set se_temp = temperature_stability * 0.5 %}
  {% set se_humidity = humidity_ok * 0.3 %}
  {% set se_hr = hr_sleep_factor * 1.0 %}
  {% set se_phone_still = phone_still_factor * 0.6 %}
  {% set se_air = max(0, min(1, co2_rising_flag * 0.2 + voc_rising_flag * 0.1)) %}
  {% if bedroom_occupied and not elsewhere_occupied %}
    {% set se_in_bed = 0.8 if (bedtime_mode_on or darkness_factor > 0.2) else 0.5 %}
  {% else %}
    {% set se_in_bed = 0 %}
  {% endif %}

  {% set ae_hr = (1 - hr_sleep_factor) * 1.0 %}
  {% set ae_presence_elsewhere = 0.8 if elsewhere_occupied else 0 %}
  {% set ae_no_bed_presence = 0.5 if not bedroom_occupied else 0 %}
  {% set ae_gaming = 0.0 %}
  {% set ae_shower = 0.0 %}
  {% set ae_tv = 0.0 %}
  {% set ae_quest = 0.0 %}
  {% set ae_hideaway = 0.92 if hideaway_on else 0 %}
  {% set ae_work_pc = 0.0 %}
  {% set ae_phone = 0.6 * max(0, (PHONE_COOLDOWN - ((now_ts - phone_last_ts) / 60)) / PHONE_COOLDOWN) if not bedtime_mode_on and not phone_active else (0.9 if phone_active else 0) %}
  {% set ae_light_on = 0.5 if (bedroom_occupied and not elsewhere_occupied and darkness_factor < 0.1) else 0 %}

  {% set sleep_probability_raw = 
       1 - (1 - se_bedtime)
           * (1 - se_phone_doze)
           * (1 - se_comfort)
           * (1 - se_darkness)
           * (1 - se_light_diff)
           * (1 - se_quietness)
           * (1 - se_temp)
           * (1 - se_humidity)
           * (1 - se_hr)
           * (1 - se_phone_still)
           * (1 - se_air)
           * (1 - se_in_bed) %}

  {% set awake_probability_raw = 
       1 - (1 - ae_hr)
           * (1 - ae_presence_elsewhere)
           * (1 - ae_no_bed_presence)
           * (1 - ae_gaming)
           * (1 - ae_shower)
           * (1 - ae_tv)
           * (1 - ae_quest)
           * (1 - ae_hideaway)
           * (1 - ae_work_pc)
           * (1 - ae_phone)
           * (1 - ae_light_on) %}

  {% set numer = sleep_probability_raw * (1 - awake_probability_raw) %}
  {% set denom = numer + ((1 - sleep_probability_raw) * awake_probability_raw) %}
  {% set sleep_probability = 0 if denom == 0 else numer / denom %}
  {% set awake_probability = 1 - sleep_probability %}

  {% set sleep_state = 'limbo' %}
  {% if gaming_on or shower_on or tv_on or quest_on or hideaway_on or work_pc_on or phone_active %}
    {% set sleep_state = 'awake' %}
  {% elif sleep_probability >= 0.85 and not gaming_on and not shower_on %}
    {% set sleep_state = 'asleep' %}
  {% elif sleep_probability < 0.75 or awake_probability_raw >= 0.90 %}
    {% set sleep_state = 'awake' %}
  {% endif %}

  {{ {
    "sleep_probability_percent": (sleep_probability * 100) | round(1),
    "awake_probability_percent": (awake_probability * 100) | round(1),
    "sleep_state": sleep_state,
    "sleep_evidence": {
      "se_bedtime": se_bedtime,
      "se_phone_doze": se_phone_doze,
      "se_comfort": se_comfort,
      "se_darkness": se_darkness,
      "se_light_diff": se_light_diff,
      "se_quietness": se_quietness,
      "se_temp": se_temp,
      "se_humidity": se_humidity,
      "se_hr": se_hr,
      "se_phone_still": se_phone_still,
      "se_air": se_air,
      "se_in_bed": se_in_bed
    },
    "awake_evidence": {
      "ae_hr": ae_hr,
      "ae_presence_elsewhere": ae_presence_elsewhere,
      "ae_no_bed_presence": ae_no_bed_presence,
      "ae_gaming": ae_gaming,
      "ae_shower": ae_shower,
      "ae_tv": ae_tv,
      "ae_quest": ae_quest,
      "ae_hideaway": ae_hideaway,
      "ae_work_pc": ae_work_pc,
      "ae_phone": ae_phone,
      "ae_light_on": ae_light_on
    },
    "raw_sensors": {
      "bedroom_lux": bedroom_lux,
      "livingroom_lux": livingroom_lux,
      "bedroom_noise": bedroom_noise,
      "noise_baseline": noise_baseline,
      "bedroom_temp": bedroom_temp,
      "temp_baseline": temp_baseline,
      "humidity": humidity,
      "co2_tracker": co2_tracker,
      "voc_tracker": voc_tracker,
      "motion_level": motion_level,
      "hr_current": hr_current,
      "hr_resting": hr_resting
    },
    "derived_factors": {
      "darkness_factor": darkness_factor,
      "light_diff_ok": light_diff_ok,
      "quietness_factor": quietness_factor,
      "temperature_stability": temperature_stability,
      "humidity_ok": humidity_ok,
      "co2_rising_flag": co2_rising_flag,
      "voc_rising_flag": voc_rising_flag,
      "phone_still_factor": phone_still_factor,
      "hr_sleep_factor": hr_sleep_factor
    }
  } }}
{% endif %}
