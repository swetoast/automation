{# 1) Gather & dedupe all lightning strikes #}
{% set raw = states
   | selectattr('entity_id','match','^geo_location\\.lightning_strike_')
   | list %}
{% set uniq = raw
   | unique(attribute='attributes.external_id')
   | list %}

{# 2) Compute lists of distances & timestamps #}
{% set distances = uniq
   | map(attribute='state')
   | map('float')
   | sort
   | list %}
{% set stamps = uniq
   | map(attribute='attributes.publication_date')
   | map('as_timestamp')
   | list %}

{# 3) Core metrics #}
{% set now_ts    = as_timestamp(now()) %}
{% set closest   = distances[0] if distances else 0 %}
{% set strike_ts = stamps|max if stamps else now_ts %}
{% set age       = (now_ts - strike_ts)|int %}
{% set strikes   = distances|length %}

{# 4) Intensity normalization [0…1] #}
{% set weak_thr   =  1 %}
{% set strong_thr = 10 %}
{% set i_norm = ((strikes - weak_thr) / (strong_thr - weak_thr)) %}
{% if i_norm < 0 %} {% set i_norm = 0 %} {% endif %}
{% if i_norm > 1 %} {% set i_norm = 1 %} {% endif %}

{# 5) Sliding window & radius by intensity #}
{% set weak_win   =  300 %}
{% set strong_win = 1800 %}
{% set window     = weak_win + i_norm * (strong_win - weak_win) %}

{% set weak_rad   = 10.0 %}
{% set strong_rad = 50.0 %}
{% set radius     = weak_rad + i_norm * (strong_rad - weak_rad) %}

{# 6) Distance norm & fade exponent #}
{% set d_norm   = (closest / radius) if radius else 1 %}
{% if d_norm > 1 %} {% set d_norm = 1 %} {% endif %}
{% set exp_low  = 4.0 %}
{% set exp_high = 0.7 %}
{% set exponent = exp_low + i_norm * (exp_high - exp_low) %}

{# 7) Fade‐out factor & timeout #}
{% set fade_factor = (1 - d_norm) ** exponent %}
{% set timeout     = window * fade_factor %}

{# 8) Active flag #}
{% set active = age <= timeout %}

{# 9) Output debug + result #}
raw_count:       {{ raw|length }}
deduped_count:   {{ uniq|length }}

distances:       {{ distances }}
timestamps:      {{ stamps }}

now_ts:          {{ now_ts|round(3) }}
closest:         {{ closest }}
strike_ts:       {{ strike_ts|round(3) }}
age:             {{ age }}

strikes:         {{ strikes }}
i_norm:          {{ i_norm|round(3) }}

window_sec:      {{ window|round(1) }}
radius_km:       {{ radius|round(2) }}

d_norm:          {{ d_norm|round(3) }}
exponent:        {{ exponent|round(3) }}

fade_factor:     {{ fade_factor|round(3) }}
timeout_sec:     {{ timeout|round(1) }}

active:          {{ active }}
