{% set payload       = states('input_text.store_lightning_monitor') | default('{}') %}
{% set data          = payload | from_json(default={}) %}

{% set now_ts        = as_timestamp(now()) %}
{% set strike_ts     = data.get('timestamp', 0) | int %}
{% set age           = (now_ts - strike_ts) | int %}

{% set distance_km   = data.get('distance', 0) | float %}
{% set strikes       = data.get('count', 0) | int %}

{% set weak_thr      =  50    %}
{% set strong_thr    = 300    %}
{% set i_norm        = ((strikes - weak_thr) / (strong_thr - weak_thr)) | float %}
{% if i_norm < 0 %} {% set i_norm = 0 %} {% endif %}
{% if i_norm > 1 %} {% set i_norm = 1 %} {% endif %}

{% set weak_win      = 300    %}
{% set strong_win    = 1800   %}
{% set window        = weak_win   + i_norm * (strong_win   - weak_win)   %}

{% set weak_rad      = 10.0   %}
{% set strong_rad    = 50.0   %}
{% set radius        = weak_rad   + i_norm * (strong_rad   - weak_rad)   %}

{% set d_norm        = distance_km / radius %}
{% if d_norm > 1 %} {% set d_norm = 1 %} {% endif %}

{% set exp_low       =  4.0   %}
{% set exp_high      =  0.7   %}
{% set exponent      = exp_low - i_norm * (exp_low - exp_high) %}

{% set fade_factor   = (1 - d_norm) ** exponent %}

{% set timeout       = window * fade_factor %}
{% set active        = age <= timeout %}


active: {{ active }}
age: {{ age }}s
distance: {{ distance_km }}km
strikes: {{ strikes }}
intensity_norm: {{ i_norm | round(2) }}
window: {{ window | round(1) }}s
radius: {{ radius | round(1) }}km
exponent: {{ exponent | round(2) }}
fade_factor: {{ fade_factor | round(3) }}
timeout: {{ timeout | round(1) }}s
