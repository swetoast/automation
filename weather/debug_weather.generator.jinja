{# === MACROS & LABELS === #}
{%- macro label_humidity(h) -%}
  {%- if h < 30 -%}dry and crisp
  {%- elif h < 60 -%}comfortable
  {%- elif h < 80 -%}a bit humid
  {%- else -%}very muggy
  {%- endif -%}
{%- endmacro %}

{%- macro label_wind(s) -%}
  {%- if s < 5 -%}light breeze
  {%- elif s < 15 -%}moderate wind
  {%- else -%}strong gusts
  {%- endif -%}
{%- endmacro %}

{%- macro humanize_direction(deg) -%}
  {%- set dirs = [
    'north','north-northeast','northeast','east-northeast',
    'east','east-southeast','southeast','south-southeast',
    'south','south-southwest','southwest','west-southwest',
    'west','west-northwest','northwest','north-northwest'
  ] -%}
  {{ dirs[((deg + 11.25)//22.5)|int % 16] }}
{%- endmacro %}

{%- set weather_labels = {
  'clear-night':'clear night','cloudy':'cloudy','fog':'foggy',
  'hail':'hail','lightning':'lightning','lightning-rainy':'thunderstorm',
  'partlycloudy':'partly cloudy','pouring':'heavy rain','rainy':'rainy',
  'snowy':'snowy','snowy-rainy':'sleet','sunny':'sunny',
  'windy':'windy','windy-variant':'gusty'
} -%}
{%- macro humanize_cond(c) -%}
  {{ weather_labels[c] if c in weather_labels else c.replace('_',' ').replace('-',' ') }}
{%- endmacro %}

{%- macro pressure_message(season, p) -%}
  {%- set s = season | lower -%}
  {%- if p < 980 -%}Intense storms
  {%- elif p < 1000 -%}Unsettled rain & gusts
  {%- elif p < 1010 -%}Showers possible
  {%- elif p < 1020 -%}Mixed sun & clouds
  {%- elif p < 1030 -%}Fair weather & light winds
  {%- else -%}Stable clear skies
  {%- endif -%}
{%- endmacro %}

{%- macro frost_message(r) -%}
  {%- if r == 'unlikely' -%}Frost unlikely
  {%- elif r == 'probable' -%}Frost possible
  {%- elif r == 'high' -%}High frost risk
  {%- endif -%}
{%- endmacro %}

{%- set fire_labels = {
  '1':'very low','2':'low','3':'moderate',
  '4':'high','5':'very high','5E':'extreme'
} -%}
{%- macro humanize_fire(i) -%}
  {{ fire_labels[i|string] if (i|string) in fire_labels else 'unknown' }}
{%- endmacro %}


{# === READ SENSORS & ATTRIBUTES === #}
{%- set tod        = states('sensor.time_of_day')                   | capitalize -%}
{%- set season     = states('sensor.season')                        | capitalize -%}
{%- set weather    = states('sensor.combined_hourly_weather')                           -%}
{%- set temp       = state_attr('sensor.combined_hourly_weather','temperature')         | round(1) -%}
{%- set cloud      = state_attr('sensor.combined_hourly_weather','cloud_coverage')       | int     -%}
{%- set press      = state_attr('sensor.combined_hourly_weather','pressure')             | int     -%}
{%- set wind_spd   = state_attr('sensor.combined_hourly_weather','wind_speed')           | round(1) -%}
{%- set wind_dir   = state_attr('sensor.combined_hourly_weather','wind_bearing')         | int     -%}
{%- set forecast   = state_attr('sensor.combined_hourly_weather','forecast') or []       -%}
{%- set frost_r    = states('sensor.thermal_outside_comfort_frost_risk')                 -%}

{# === FORECAST DEBUG SETUP === #}
{%- set forecast_horizon = 3 -%}
{%- set peak = namespace(val=0.0) -%}
{% for slot in forecast[:forecast_horizon] %}
  {% if slot.temperature is defined and slot.temperature > peak.val %}
    {% set peak.val = slot.temperature %}
  {% endif %}
{% endfor %}
{%- set fc_diff  = peak.val - 25 if peak.val > 25 else 0 -%}
{%- set drop_pre = fc_diff > 0 and (fc_diff * 2.0 / (fc_diff + 2.0)) or 0 -%}

{# === DEBUG OUTPUT === #}
Time of day:            {{ tod }}
Season:                 {{ season }}
Weather:                {{ weather }} → {{ humanize_cond(weather) }}
Temperature:            {{ temp }}°C
Cloud cover:            {{ cloud }}%
Pressure:               {{ press }} hPa → {{ pressure_message(season, press) }}
Wind:                   {{ wind_spd }} km/h from {{ wind_dir }}° → {{ label_wind(wind_spd) }} {{ humanize_direction(wind_dir) }}
Frost risk:             {{ frost_r }} → {{ frost_message(frost_r) }}

Forecast slots (next {{ forecast_horizon }} hours):
{% for slot in forecast[:forecast_horizon] %}
  • Slot {{ loop.index }}  
     - Time:        {{ slot.datetime }}  
     - Temp:        {{ slot.temperature }}°C  
     - Condition:   {{ slot.condition }} → {{ humanize_cond(slot.condition) }}  
     - Precipitation: {{ slot.precipitation }} mm  
{% endfor %}

Peak forecast temp:       {{ peak.val }}°C  
Pre-cool diff (peak–25):  {{ fc_diff }}°C  
drop_pre (max 2.0):       {{ drop_pre }}°C  

{# — identify all rainy slots after “now” —#}
{%- set now_ts    = as_timestamp(now()) -%}
{%- set precip_fx = forecast
   | selectattr('precipitation','>',0)
   | selectattr('datetime','>', now_ts 
       | timestamp_custom('%Y-%m-%dT%H:%M:%S%z',false))
   | list -%}

Precipitation events:
{% if precip_fx %}
  {% for evt in precip_fx %}
• time: {{ evt.datetime }} → {{ evt.precipitation }} mm  
  {% endfor %}
{% else %}
• none
{% endif %}
