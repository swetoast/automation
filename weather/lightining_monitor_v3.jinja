{% set raw = states
   | selectattr('entity_id','match','^geo_location\\.lightning_strike_')
   | list %}
{% set uniq = raw
   | unique(attribute='attributes.external_id')
   | list %}

{% set distances = uniq | map(attribute='state') | map('float') | sort | list %}
{% set stamps    = uniq | map(attribute='attributes.publication_date') | map('as_timestamp') | list %}
{% set has_data  = distances | length > 0 and stamps | length > 0 %}

{% set now_ts    = as_timestamp(now()) %}
{% set closest   = distances[0] if has_data else none %}
{% set strike_ts = stamps|max if has_data else none %}
{% set age       = (now_ts - strike_ts)|int if has_data else none %}
{% set strikes   = distances|length %}

{% set weak_thr   = 1 %}
{% set strong_thr = 10 %}
{% set i_norm     = ((strikes - weak_thr) / (strong_thr - weak_thr)) if has_data else 0 %}
{% if i_norm < 0 %} {% set i_norm = 0 %} {% endif %}
{% if i_norm > 1 %} {% set i_norm = 1 %} {% endif %}

{% set weak_win   = 300 %}
{% set strong_win = 1800 %}
{% set window     = weak_win + i_norm * (strong_win - weak_win) %}

{% set weak_rad   = 10.0 %}
{% set strong_rad = 50.0 %}
{% set radius     = weak_rad + i_norm * (strong_rad - weak_rad) %}

{% set d_norm     = (closest / radius) if has_data and radius else 1 %}
{% if d_norm > 1 %} {% set d_norm = 1 %} {% endif %}
{% set exp_low    = 4.0 %}
{% set exp_high   = 0.7 %}
{% set exponent   = exp_low + i_norm * (exp_high - exp_low) %}

{% set fade       = (1 - d_norm) ** exponent %}
{% set timeout    = window * fade if has_data else 0 %}
{% set active     = has_data and age <= timeout %}

raw_count:       {{ raw|length }}
deduped_count:   {{ uniq|length }}
distances:       {{ distances }}
timestamps:      {{ stamps }}
has_data:        {{ has_data }}

now_ts:          {{ now_ts|round(3) }}
closest:         {{ closest }}
strike_ts:       {{ strike_ts }}
age:             {{ age }}

strikes:         {{ strikes }}
i_norm:          {{ i_norm|round(3) }}

window_sec:      {{ window|round(1) }}
radius_km:       {{ radius|round(2) }}

d_norm:          {{ d_norm|round(3) }}
exponent:        {{ exponent|round(3) }}
fade_factor:     {{ fade|round(3) }}
timeout_sec:     {{ timeout|round(1) }}

active:          {{ active }}
