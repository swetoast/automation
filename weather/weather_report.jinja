{%- macro label_humidity(h) -%}
  {%- if h < 30 -%}dry and crisp
  {%- elif h < 60 -%}comfortable
  {%- elif h < 80 -%}a bit humid
  {%- else -%}very muggy
  {%- endif -%}
{%- endmacro %}

{%- macro label_pressure(p) -%}
  {%- if p < 1010 -%}unstable skies
  {%- elif p < 1015 -%}moderate pressure
  {%- else -%}stable high pressure
  {%- endif -%}
{%- endmacro %}

{%- macro label_wind(s) -%}
  {%- if s < 5 -%}light breeze
  {%- elif s < 15 -%}moderate wind
  {%- else -%}strong gusts
  {%- endif -%}
{%- endmacro %}

{%- macro humanize_direction(deg) -%}
  {%- set dirs = [
    'north','north-northeast','northeast','east-northeast',
    'east','east-southeast','southeast','south-southeast',
    'south','south-southwest','southwest','west-southwest',
    'west','west-northwest','northwest','north-northwest'
  ] -%}
  {{ dirs[((deg + 11.25)//22.5)|int % 16] }}
{%- endmacro %}

{%- set weather_labels = {
  'clear-night':'clear night','cloudy':'cloudy','fog':'foggy',
  'hail':'hail','lightning':'lightning','lightning-rainy':'thunderstorm',
  'partlycloudy':'partly cloudy','pouring':'heavy rain','rainy':'rainy',
  'snowy':'snowy','snowy-rainy':'sleet','sunny':'sunny',
  'windy':'windy','windy-variant':'gusty'
} -%}
{%- macro humanize_cond(c) -%}
  {{ weather_labels[c] if c in weather_labels else c.replace('_',' ').replace('-',' ') }}
{%- endmacro %}

{%- macro pressure_message(season,p) -%}
  {%- if p < 1010 -%}Storm risk today
  {%- elif p < 1015 -%}Showers possible
  {%- endif -%}
{%- endmacro %}

{%- macro frost_message(r) -%}
  {%- if r == 'unlikely' -%}Frost unlikely
  {%- elif r == 'probable' -%}Frost possible
  {%- elif r == 'high' -%}High frost risk
  {%- endif -%}
{%- endmacro %}

{%- set fire_labels = {
  '1':'very low','2':'low','3':'moderate',
  '4':'high','5':'very high','5E':'extreme'
} -%}
{%- macro humanize_fire(i) -%}
  {{ fire_labels[i|string] if (i|string) in fire_labels else 'unknown' }}
{%- endmacro %}

{%- set tod       = states('sensor.time_of_day')                   | capitalize -%}
{%- set cal_start = state_attr('calendar.calander','start_time')   -%}
{%- if cal_start and as_datetime(cal_start).date() == now().date() -%}
  {%- set holiday = state_attr('calendar.calander','message')     -%}
{%- else -%}
  {%- set holiday = none                                       -%}
{%- endif -%}

{%- set weather    = states('sensor.combined_hourly_weather')                         -%}
{%- set temp       = state_attr('sensor.combined_hourly_weather','temperature')       | round(1) -%}
{%- set dew_perc   = states('sensor.thermal_outside_comfort_dew_point_perception')     | replace('_',' ') -%}
{%- set humidex    = states('sensor.thermal_outside_comfort_humidex_perception')       | replace('_',' ') -%}
{%- set frost_r    = states('sensor.thermal_outside_comfort_frost_risk')               -%}
{%- set cloud      = state_attr('sensor.combined_hourly_weather','cloud_coverage')     | int     -%}
{%- set press      = state_attr('sensor.combined_hourly_weather','pressure')           | int     -%}
{%- set wind_spd   = state_attr('sensor.combined_hourly_weather','wind_speed')         | round(1) -%}
{%- set wind_dir   = state_attr('sensor.combined_hourly_weather','wind_bearing')       | int     -%}
{%- set forecast   = state_attr('sensor.combined_hourly_weather','forecast')           -%}

{%- set rain_states = [
  'rainy','pouring','lightning-rainy','snowy','snowy-rainy'
] -%}
{%- set rain_alert = states('sensor.rain_alert') | int                                 -%}
{%- set now_ts     = as_timestamp(now())                                              -%}
{%- set precip_fx  = forecast
   | selectattr('precipitation','>',0)
   | selectattr('datetime','>', now_ts|timestamp_custom('%Y-%m-%dT%H:%M:%S%z',false))
   | list                                                                          -%}

{%- set uv_index = states('sensor.uv_index_sensor')                                | float   -%}
{%- set spf      = states('sensor.spf_recommendation')                            -%}
{%- set sun_exp  = states('sensor.sun_exposure_time')                             -%}
{%- set fire_idx = state_attr('sensor.brandrisk_ute','riskIndex')                -%}

{%- set aurora_on = states('binary_sensor.aurora_visibility_alert')=='on'         -%}
{%- set aurora_ch = states('sensor.aurora_visibility_visibility')|float           -%}
{%- set thunder   = states('sensor.chance_of_thunder') in ['on','true','yes']     -%}

{%- set pollens = [] -%}
{%- for p in ['Alder','Birch','Grasses','Mugwort','Olive Tree','Ragweed'] -%}
  {%- set lvl = state_attr('sensor.pollen_data',p)|float -%}
  {%- if lvl >= 8 -%}{%- set pollens = pollens + [p~' high'] -%}
  {%- elif lvl >= 4 -%}{%- set pollens = pollens + [p~' med'] -%}{%- endif -%}
{%- endfor -%}

{%- set narrative = [] -%}

{% if holiday %}
  {% set narrative = narrative + [ "Today is " ~ holiday ~ "." ] %}
{% else %}
  {% set narrative = narrative + [ "Good " ~ tod ~ "." ] %}
{% endif %}

{% if weather %}
  {% set narrative = narrative + [
    humanize_cond(weather) ~ " skies " ~ cloud ~ "%, " ~ temp ~ "°C."
  ] %}
{% endif %}

{% if weather in rain_states %}
  {% set narrative = narrative + [ "Raining now." ] %}
{% elif rain_alert > 0 %}
  {% set narrative = narrative + [ "Rain in " ~ rain_alert ~ " min." ] %}
{% elif precip_fx %}
  {% set nt  = as_timestamp(precip_fx[0].datetime) | timestamp_custom('%H:%M',false) %}
  {% set amt = precip_fx[0].precipitation | round(1) %}
  {% set narrative = narrative + [ "Expect rain at " ~ nt ~ " (" ~ amt ~ " mm)." ] %}
{% endif %}

{% if dew_perc %}
  {% set narrative = narrative + [ "Air feels " ~ dew_perc ~ "." ] %}
{% endif %}
{% if humidex not in ['comfortable'] %}
  {% set narrative = narrative + [ "Humidex " ~ humidex ~ "." ] %}
{% endif %}

{% set fl = frost_message(frost_r) %}
{% if fl %}
  {% set narrative = narrative + [ fl ~ "." ] %}
{% endif %}

{% set sr = pressure_message(season, press) %}
{% if sr %}
  {% set narrative = narrative + [ sr ~ "." ] %}
{% endif %}

{% if wind_spd is not none %}
  {% set narrative = narrative + [
    label_wind(wind_spd) ~ " " ~ humanize_direction(wind_dir) ~
    " " ~ wind_spd ~ " km/h."
  ] %}
{% endif %}

{% if aurora_on %}
  {% set narrative = narrative + [ "Aurora visible." ] %}
{% elif aurora_ch > 0 %}
  {% set narrative = narrative + [ "Aurora chance " ~ aurora_ch ~ "%." ] %}
{% endif %}
{% if thunder %}
  {% set narrative = narrative + [ "Thunder—take care." ] %}
{% endif %}

{% if forecast and forecast|length > 1 %}
  {% for slot in forecast[1:4] %}
    {% set tm  = slot.datetime[11:16] %}
    {% set tmp = slot.temperature | round(1) %}
    {% set pr  = slot.precipitation | float %}
    {% set tag = pr>0 and ((tmp<=0 and "snow") or "rain") ~ " expected" or "" %}
    {% set narrative = narrative + [
      tm ~ " " ~ humanize_cond(slot.condition) ~
      " " ~ tmp ~ "°C" ~ (tag and " (" ~ tag ~ ")") ~ "."
    ] %}
  {% endfor %}
{% endif %}

{% if pollens %}
  {% set narrative = narrative + [ "Pollen: " ~ pollens | join(", ") ~ "." ] %}
{% endif %}

{% if uv_index >= 3 %}
  {% set uv_msg = uv_index < 6
       and "UV " ~ uv_index ~ " sunscreen advised."
       or  "UV " ~ uv_index ~ " strong protection." %}
  {% set narrative = narrative + [ uv_msg ] %}
  {% if spf and sun_exp %}
    {% set narrative = narrative + [
      "SPF " ~ spf ~ "; safe sun " ~ sun_exp ~ " min."
    ] %}
  {% endif %}
{% endif %}

{% if fire_idx %}
  {% set narrative = narrative + [ "Fire risk is " ~ humanize_fire(fire_idx) ~ " outside." ] %}
{% endif %}

{{ narrative | join(" ") }}
